{
  "name": "browsing",
  "productName": "Browsing",
  "version": "1.4.0",
  "description": "A minimal monochrome web browser",
  "main": "main.js",
  "author": "Browsing",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "@fontsource-variable/urbanist": "^5.0.0",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.browsing.app",
    "productName": "Browsing",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "guest-preload.js",
      "src/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Browsing-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dexvior",
        "repo": "Browsing-Web-Browser",
        "releaseType": "release"
      }
    ]
  }
}